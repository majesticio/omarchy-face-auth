# Based on the AUR python-dlib recipe, restricted to a CPU build.
pkgname=python-dlib
pkgver=20.0.1
pkgrel=2
pkgdesc='Dlib Python bindings, local CPU-only build for facial recognition'
arch=('x86_64')
url='https://github.com/davisking/dlib'
license=('BSL-1.0')
depends=('python' 'cblas' 'lapack' 'libx11' 'libgif.so' 'libjpeg.so' 'libjxl.so' 'libjxl_threads.so' 'libpng16.so' 'libwebp.so')
makedepends=('boost' 'cmake' 'python-setuptools' 'sqlite')
source=('dlib-20.0.1.tar.gz::https://github.com/davisking/dlib/archive/refs/tags/v20.0.1.tar.gz')
sha256sums=('dab5b4ec4b68bd7dc128a1fb7900723f89d2da107e44cd5def7d38fc57252a9d')
options=('!debug')
prepare() {
  # Upstream's custom CMake build ignores setuptools --parallel and computes
  # its own job count. Pin that call, too, to avoid saturating this laptop.
  sed -i 's/str(num_available_cpu_cores(2))/str(2)/' "$srcdir/dlib-$pkgver/setup.py"
}
build() {
  cd "$srcdir/dlib-$pkgver"
  DLIB_USE_CUDA=OFF python setup.py build
}
package() {
  cd "$srcdir/dlib-$pkgver"
  python setup.py install --skip-build --prefix=/usr --root="$pkgdir" --optimize=1
  install -Dm644 dlib/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
