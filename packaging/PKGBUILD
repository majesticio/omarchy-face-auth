# Native, reproducible recognition backend. PAM policy is owned by this plugin.
pkgname=omarchy-face-auth-howdy-next
pkgver=3.4.0
pkgrel=1
pkgdesc='Pinned howdy-next backend for the Omarchy face authentication plugin'
arch=('x86_64')
url='https://codeberg.org/nathawat/howdy-next'
license=('GPL-3.0-or-later')
depends=('acl' 'curl>=7.85.0' 'glibc>=2.34' 'libevdev' 'libinih>=59'
         'openssl' 'opencv>=5.0.0' 'pam' 'qt6-base' 'yyjson>=0.12.0')
makedepends=('cmake>=3.31' 'gettext')
optdepends=('linux-enable-ir-emitter: enable IR cameras that need a software emitter')
provides=('howdy')
conflicts=('howdy' 'howdy-git' 'howdy-next' 'howdy-next-git' 'omarchy-face-auth-howdy')
backup=('etc/howdy/config.ini')
options=('!debug')

_commit=b0b3d290cbd38a0a44f6bf0a37b414210acf8276
source=(
  "howdy-next-$_commit.tar.gz::https://codeberg.org/nathawat/howdy-next/archive/$_commit.tar.gz"
  'face_detection_yunet_2026may.onnx::https://github.com/opencv/opencv_zoo/raw/26cc381e4d2594bb9f47a26eb8fd96c94a13660d/models/face_detection_yunet/face_detection_yunet_2026may.onnx'
  'face_recognition_sface_2021dec_int8.onnx::https://github.com/opencv/opencv_zoo/raw/088c3571ec70df15100a5e4c26894d95951e92e9/models/face_recognition_sface/face_recognition_sface_2021dec_int8.onnx'
)
sha256sums=(
  '8454f74ae48f3284b25b74c16ab6f9806ba2b8b1857a6c5f740c8c62b24937fd'
  'ebafce4e3c118d6554634be5c27ab333b4c047a9a8c3faf1d7cf93101c22f0f0'
  '2b0e941e6f16cc048c20aee0c8e31f569118f65d702914540f7bfdc14048d78a'
)

build() {
  cmake -S howdy-next -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DHOWDY_GIT_COMMIT="$_commit" \
    -DHOWDY_LICENSES_INSTALL_DIR="share/licenses/$pkgname"
  cmake --build build -j 2
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 face_detection_yunet_2026may.onnx \
    "$pkgdir/usr/share/howdy/models/face_detection_yunet_2026may.onnx"
  install -Dm644 face_recognition_sface_2021dec_int8.onnx \
    "$pkgdir/usr/share/howdy/models/face_recognition_sface_2021dec_int8.onnx"
}
