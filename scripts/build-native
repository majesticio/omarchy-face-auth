#!/bin/bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
mkdir -p build
flags=(-std=c11 -O2 -Wall -Wextra -Werror -fstack-protector-strong -D_FORTIFY_SOURCE=3)
cc "${flags[@]}" -fPIC -shared -Wl,-z,relro,-z,now,-z,noexecstack \
  -o build/pam_face_intent.so native/intent.c -lpam -ljson-c -lsystemd
