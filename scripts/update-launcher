#!/bin/bash
set -euo pipefail

[[ $EUID == 0 && $# == 3 ]] || exit 1
user=$1
uid=$2
source_root=$3
[[ $uid =~ ^[0-9]+$ && $uid -gt 0 ]] || exit 1
account=$(getent passwd "$uid" | cut -d: -f1)
[[ $account == "$user" ]] || exit 1
[[ -d $source_root && ! -L $source_root && $(stat -c %u "$source_root") == "$uid" ]] || exit 1
source_mode=$(stat -c %a "$source_root")
(( (8#$source_mode & 8#022) == 0 )) || exit 1
source_root=$(readlink -f -- "$source_root")
[[ $source_root == "$(getent passwd "$uid" | cut -d: -f6)"/.config/omarchy/plugins/io.github.majesticio.face-auth ]] || {
  echo 'Run updates from the installed Omarchy plugin directory.' >&2
  exit 1
}
required=(
  native/backend.py native/dialog.py
  pam/omarchy-face-password pam/omarchy-face-rescan pam/omarchy-lock-face
  scripts/configure.py scripts/update-launcher scripts/update-system scripts/uninstall-system
  build/pam_face_intent.so
)
for relative in "${required[@]}"; do
  candidate=$source_root/$relative
  [[ -f $candidate && ! -L $candidate && $(stat -c %u "$candidate") == "$uid" ]] || exit 1
  mode=$(stat -c %a "$candidate")
  (( (8#$mode & 8#022) == 0 )) || { echo "Writable update input: $relative" >&2; exit 1; }
done
stage=$(mktemp -d /var/lib/omarchy-face-auth/stage.XXXXXXXX)
chmod 0700 "$stage"
cleanup() { rm -rf -- "$stage"; }
trap cleanup EXIT
for directory in native pam scripts build; do
  install -d -o root -g root -m 0700 "$stage/$directory"
done
for relative in "${required[@]}"; do
  install -o root -g root -m 0600 "$source_root/$relative" "$stage/$relative"
done
chmod 0700 "$stage/scripts/update-launcher" "$stage/scripts/update-system"
/usr/lib/omarchy-face-auth/update-system "$user" "$uid" "$stage"
/usr/lib/omarchy-face-auth/backend.py sync-status
