<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Face Authentication for Omarchy</vendor>
  <action id="io.github.majesticio.face-auth.manage">
    <description>Manage face authentication</description>
    <message>Manage face authentication</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <!-- The fixed root helper separately requires a fresh password using
           omarchy-face-password before EVERY mutation. No arbitrary commands. -->
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/omarchy-face-auth/backend.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">manage</annotate>
  </action>
</policyconfig>
